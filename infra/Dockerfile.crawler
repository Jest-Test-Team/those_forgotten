FROM python:3.13-slim
WORKDIR /app

COPY services/crawler/pyproject.toml ./
COPY services/crawler/README.md ./
COPY services/crawler/crawler ./crawler
COPY services/crawler/fixtures ./fixtures
COPY services/crawler/scripts ./scripts

RUN pip install --no-cache-dir -e .
RUN chmod +x /app/scripts/run-crawler.sh

CMD ["/app/scripts/run-crawler.sh"]
