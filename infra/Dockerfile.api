FROM golang:1.24-alpine AS builder
WORKDIR /src

COPY services/api-go/go.mod services/api-go/go.sum ./
RUN go mod download

COPY services/api-go ./
RUN go build -o /bin/api ./cmd/api

FROM alpine:3.21
RUN adduser -D appuser
USER appuser
WORKDIR /app
ENV PORT=8080

COPY --from=builder /bin/api ./api

EXPOSE 8080

CMD ["./api"]
